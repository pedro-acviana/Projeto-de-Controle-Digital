22:25:56 #--- proj1cdig: comandos (uma linha cada) ---
22:25:56 # x                      para tudo (aquecedor e cooler em 0)
22:25:57 # s                      so le sensores, aquecedor em 0 (log 1 s)
22:25:57 # o <u>                  malha aberta, aquecedor fixo em u (0..21000)
22:25:57 # p [u0 du duracao_bit_s tempo_aquecimento_s]
22:25:57 #                        PRBS: fica tempo_aquecimento_s em u0, depois alterna
22:25:57 #                        u0+du / u0-du, cada nivel durando duracao_bit_s
22:25:57 # c [ref]                malha fechada PI, Ts=2629 ms (ref padrao 50.0)
22:25:57 # r <ref>                degrau de referencia (em CTRL)
22:25:57 # a <0|1>                anti-windup desligado/ligado
22:25:57 # e [r_baixa r_alta meio_periodo_s]
22:25:57 #                        ensaio do roteiro (Fig. 5): onda quadrada (padrao P.O. / P.O.+10,
22:25:57 #                        400 s) + perturbacao constante e triangular, 3600 s, calcula o ISE
22:25:57 # k <K> <z0>             troca o PI sem regravar
22:25:57 # w0 | wc <w> | ws | wt  cooler: off | constante | senoide | triangular
22:25:57 # h                      esta ajuda
